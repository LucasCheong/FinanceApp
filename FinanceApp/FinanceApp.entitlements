<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud 已移除：免費 Apple ID（Personal Team）不支持 iCloud capability，
	     保留會導致 "Cannot create a iOS App Development provisioning profile"。
	     取得付費開發者帳號後，把下面兩組 key 加回，並將 CloudSyncService.isEnabled 改為 true：
	     com.apple.developer.icloud-services = [CloudDocuments]
	     com.apple.developer.icloud-container-identifiers = [iCloud.com.lucascheong.financeapp] -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.lucascheong.financeapp</string>
	</array>
</dict>
</plist>
